+void DisplayServerSwitch::_poll_joypad() {
+	padUpdate(&pad);
+	bool connected = padIsConnected(&pad);
+	if (connected != joy_connected) {
+		joy_connected = connected;
+		Input::get_singleton()->joy_connection_changed(0, connected, "Nintendo Switch Controller", "");
+		if (!connected) {
+			prev_buttons = 0;
+			for (float &a : prev_axes) {
+				a = 0;
+			}
+		}
+	}
+	if (!connected) {
+		return;
+	}
+	Input *input = Input::get_singleton();
+	u64 buttons = padGetButtons(&pad);
+	u64 changed = buttons ^ prev_buttons;
+	for (const auto &m : button_map) {
+		if (changed & m.mask) {
+			input->joy_button(0, m.button, (buttons & m.mask) != 0);
+		}
+	}
+	_poll_cursor(buttons, prev_buttons);
+	prev_buttons = buttons;
+
+	HidAnalogStickState l = padGetStickPos(&pad, 0);
+	HidAnalogStickState r = padGetStickPos(&pad, 1);
+	float axes[6] = {
+		l.x / float(JOYSTICK_MAX), -l.y / float(JOYSTICK_MAX),
+		r.x / float(JOYSTICK_MAX), -r.y / float(JOYSTICK_MAX),
+		(buttons & HidNpadButton_ZL) ? 1.0f : 0.0f,
+		(buttons & HidNpadButton_ZR) ? 1.0f : 0.0f,
+	};
+	for (int i = 0; i < 6; i++) {
+		if (axes[i] != prev_axes[i]) {
+			input->joy_axis(0, JoyAxis(i), axes[i]);
+			prev_axes[i] = axes[i];
+		}
+	}
+}
+
+void DisplayServerSwitch::_poll_touch() {
+	HidTouchScreenState state = {};
+	if (!hidGetTouchScreenStates(&state, 1)) {
+		return;
+	}
+	// Touch panel is always 1280x720; scale to the render size.
+	float sx = size.x / 1280.0f, sy = size.y / 720.0f;
+
+	// Releases: fingers present before but gone now.
+	for (s32 i = 0; i < prev_touch.count; i++) {
+		bool still = false;
+		for (s32 j = 0; j < state.count; j++) {
+			if (state.touches[j].finger_id == prev_touch.touches[i].finger_id) {
+				still = true;
+			}
+		}
+		if (!still) {
+			Ref<InputEventScreenTouch> ev;
+			ev.instantiate();
+			ev->set_index(prev_touch.touches[i].finger_id);
+			ev->set_position(Vector2(prev_touch.touches[i].x * sx, prev_touch.touches[i].y * sy));
+			ev->set_pressed(false);
+			Input::get_singleton()->parse_input_event(ev);
+		}
+	}
+	for (s32 j = 0; j < state.count; j++) {
+		const HidTouchState &t = state.touches[j];
+		Vector2 pos(t.x * sx, t.y * sy);
+		const HidTouchState *old = nullptr;
+		for (s32 i = 0; i < prev_touch.count; i++) {
+			if (prev_touch.touches[i].finger_id == t.finger_id) {
+				old = &prev_touch.touches[i];
+			}
+		}
+		if (!old) {
+			Ref<InputEventScreenTouch> ev;
+			ev.instantiate();
+			ev->set_index(t.finger_id);
+			ev->set_position(pos);
+			ev->set_pressed(true);
+			Input::get_singleton()->parse_input_event(ev);
+		} else if (old->x != t.x || old->y != t.y) {
+			Ref<InputEventScreenDrag> ev;
+			ev.instantiate();
+			ev->set_index(t.finger_id);
+			ev->set_position(pos);
+			ev->set_relative(pos - Vector2(old->x * sx, old->y * sy));
+			Input::get_singleton()->parse_input_event(ev);
+		}
+		mouse_pos = Point2i(pos);
+		cursor_pos = pos;
+	}
+	prev_touch = state;
+}
+
+// Virtual mouse: right stick moves the cursor, ZR = left click, ZL = right click.
+void DisplayServerSwitch::_mouse_button(MouseButton p_button, bool p_pressed) {
+	MouseButtonMask m = mouse_button_to_mask(p_button);
+	if (p_pressed) {
+		mouse_buttons.set_flag(m);
+	} else {
+		mouse_buttons.clear_flag(m);
+	}
+	Ref<InputEventMouseButton> ev;
+	ev.instantiate();
+	ev->set_button_index(p_button);
+	ev->set_pressed(p_pressed);
+	ev->set_position(mouse_pos);
+	ev->set_global_position(mouse_pos);
+	ev->set_button_mask(mouse_buttons);
+	Input::get_singleton()->parse_input_event(ev);
+}
+
+void DisplayServerSwitch::_poll_cursor(u64 p_buttons, u64 p_prev) {
+	uint64_t now = OS::get_singleton()->get_ticks_usec();
+	float dt = last_ticks ? MIN((now - last_ticks) / 1000000.0f, 0.1f) : 0.0f;
+	last_ticks = now;
+
+	HidAnalogStickState r = padGetStickPos(&pad, 1);
+	Vector2 v(r.x / float(JOYSTICK_MAX), -r.y / float(JOYSTICK_MAX));
+	float len = v.length();
+	const float dead = 0.15f;
+	if (len > dead) {
+		// Curve for fine aiming near the centre; full tilt crosses the screen in ~1 s.
+		float t = MIN((len - dead) / (1.0f - dead), 1.0f);
+		Vector2 vel = v / len * (t * t) * size.x * 1.0f;
+		Vector2 np = (cursor_pos + vel * dt).clamp(Vector2(), Vector2(size.x - 1, size.y - 1));
+		Vector2 rel = np - cursor_pos;
+		cursor_pos = np;
+		Point2i ip = Point2i(np);
+		if (ip != mouse_pos || rel != Vector2()) {
+			Vector2 old = mouse_pos;
+			mouse_pos = ip;
+			Ref<InputEventMouseMotion> ev;
+			ev.instantiate();
+			ev->set_position(mouse_pos);
+			ev->set_global_position(mouse_pos);
+			ev->set_relative(Vector2(mouse_pos) - old);
+			ev->set_velocity(vel);
+			ev->set_button_mask(mouse_buttons);
+			Input::get_singleton()->parse_input_event(ev);
+		}
+	}
+
+	u64 changed = p_buttons ^ p_prev;
+	if (changed & HidNpadButton_ZR) {
+		_mouse_button(MouseButton::LEFT, p_buttons & HidNpadButton_ZR);
+	}
+	if (changed & HidNpadButton_ZL) {
+		_mouse_button(MouseButton::RIGHT, p_buttons & HidNpadButton_ZL);
+	}
+}
+
+void DisplayServerSwitch::mouse_set_mode(MouseMode p_mode) {
