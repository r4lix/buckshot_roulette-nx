+// Switch port: 3D upscale with contrast-adaptive sharpening (after AMD FidelityFX CAS), so a lower 3D resolution
+// keeps its edges. Sharpness from ProjectSettings "nx/sharpness" (0 = plain bilinear, 1 = strongest).
+static GLuint nx_cas_program = 0;
+static GLint nx_cas_u_src = -1, nx_cas_u_texel = -1, nx_cas_u_sharp = -1;
+
+static GLuint nx_cas_compile(GLenum type, const char *src) {
+	GLuint sh = glCreateShader(type);
+	glShaderSource(sh, 1, &src, nullptr);
+	glCompileShader(sh);
+	GLint ok = 0;
+	glGetShaderiv(sh, GL_COMPILE_STATUS, &ok);
+	if (!ok) {
+		char log[1024];
+		glGetShaderInfoLog(sh, sizeof(log), nullptr, log);
+		ERR_PRINT(String("CAS shader: ") + log);
+	}
+	return sh;
+}
+
+static bool nx_cas_init() {
+	if (nx_cas_program) {
+		return true;
+	}
+	static const char *vs =
+			"#version 300 es\n"
+			"layout(location = 0) in vec2 vertex;\n"
+			"out vec2 uv;\n"
+			"void main() { uv = vertex * 0.5 + 0.5; gl_Position = vec4(vertex, 0.0, 1.0); }\n";
+	static const char *fs =
+			"#version 300 es\n"
+			"precision mediump float;\n"
+			"uniform sampler2D src;\n"
+			"uniform vec2 texel;\n"
+			"uniform float sharp;\n"
+			"in vec2 uv;\n"
+			"out vec4 frag;\n"
+			"void main() {\n"
+			"  vec4 e4 = texture(src, uv);\n"
+			"  vec3 e = e4.rgb;\n"
+			"  vec3 b = texture(src, uv + vec2(0.0, -texel.y)).rgb;\n"
+			"  vec3 d = texture(src, uv + vec2(-texel.x, 0.0)).rgb;\n"
+			"  vec3 f = texture(src, uv + vec2(texel.x, 0.0)).rgb;\n"
+			"  vec3 h = texture(src, uv + vec2(0.0, texel.y)).rgb;\n"
+			"  vec3 mn = min(e, min(min(b, d), min(f, h)));\n"
+			"  vec3 mx = max(e, max(max(b, d), max(f, h)));\n"
+			"  vec3 amp = sqrt(clamp(min(mn, 1.0 - mx) / max(mx, vec3(1e-4)), 0.0, 1.0));\n"
+			"  vec3 w = amp * mix(-0.125, -0.2, sharp);\n"
+			"  vec3 c = (e + (b + d + f + h) * w) / (1.0 + 4.0 * w);\n"
+			"  frag = vec4(clamp(c, 0.0, 1.0), e4.a);\n"
+			"}\n";
+	GLuint v = nx_cas_compile(GL_VERTEX_SHADER, vs);
+	GLuint f = nx_cas_compile(GL_FRAGMENT_SHADER, fs);
+	GLuint p = glCreateProgram();
+	glAttachShader(p, v);
+	glAttachShader(p, f);
+	glBindAttribLocation(p, 0, "vertex");
+	glLinkProgram(p);
+	glDeleteShader(v);
+	glDeleteShader(f);
+	GLint ok = 0;
+	glGetProgramiv(p, GL_LINK_STATUS, &ok);
+	if (!ok) {
+		ERR_PRINT("CAS program failed to link, using bilinear upscale.");
+		glDeleteProgram(p);
+		return false;
+	}
+	nx_cas_program = p;
+	nx_cas_u_src = glGetUniformLocation(p, "src");
+	nx_cas_u_texel = glGetUniformLocation(p, "texel");
+	nx_cas_u_sharp = glGetUniformLocation(p, "sharp");
+	return true;
+}
