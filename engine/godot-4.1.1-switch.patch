+void DisplayServerSwitch::swap_buffers() {
+#ifdef GLES3_ENABLED
+	if (egl_display != EGL_NO_DISPLAY) {
+		eglSwapBuffers(egl_display, egl_surface);
+	}
+#endif
+}
+
+void DisplayServerSwitch::window_set_vsync_mode(VSyncMode p_vsync_mode, WindowID p_window) {
+	vsync_mode = p_vsync_mode;
+#ifdef VULKAN_ENABLED
+	if (context_vulkan) {
+		context_vulkan->set_vsync_mode(p_window, p_vsync_mode);
+	}
+#endif
+#ifdef GLES3_ENABLED
+	if (egl_display != EGL_NO_DISPLAY) {
+		// nx/swap_interval: 1 = 60 Hz, 2 = locked 30 fps (set in override.cfg as [nx] swap_interval=2).
+		int interval = 1;
+		if (ProjectSettings::get_singleton() && ProjectSettings::get_singleton()->has_setting("nx/swap_interval")) {
+			interval = CLAMP((int)GLOBAL_GET("nx/swap_interval"), 1, 4);
+		}
+		eglSwapInterval(egl_display, p_vsync_mode == VSYNC_DISABLED ? 0 : interval);
+#ifdef NX_ZINK
+		// Zink presents through Vulkan (FIFO): the hook enforces intervals above 1 (nx_zink_hook.cpp).
+		extern int nx_zink_swap_interval;
+		nx_zink_swap_interval = p_vsync_mode == VSYNC_DISABLED ? 0 : interval;
+#endif
+	}
+#endif
+}
+
+DisplayServer::VSyncMode DisplayServerSwitch::window_get_vsync_mode(WindowID p_window) const {
+	return vsync_mode;
+}
