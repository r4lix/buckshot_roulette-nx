+#include <EGL/eglext.h>
+#undef Thread
+#undef Mutex
+#undef Semaphore
+#undef AudioDriver
+#undef RwLock
+#undef CondVar
+#undef Barrier
+#endif
diff --git a/platform/switch/nx_zink_hook.cpp b/platform/switch/nx_zink_hook.cpp
new file mode 100644
index 0000000..d6e9aa9
--- /dev/null
+++ b/platform/switch/nx_zink_hook.cpp
@@ -0,0 +1,469 @@
+// Zink build (zink=yes): a tiny "Vulkan layer" between Zink and nxvk.
+//
+// Zink resolves Vulkan through two symbols; in the hooked archive (libnvk_gl_hooked.a, made with objcopy
+// --redefine-sym) they point here. Everything passes through, except:
+//   vkCreateDevice / vkGetDeviceQueue   remember Zink's device and queue
+//   vkCreateSwapchainKHR                FIFO, one more image, transfer usage (to read and write the images)
+//   vkQueuePresentKHR                   30 fps lock, and LSFG frame generation on Zink's own frame (no readback):
+//                                       the real frame goes into lsfg; the generated in-between frame is written into
+//                                       Zink's image and presented first, then the real frame from the next image.
+// LSFG (lsfg-vk, GPL-3.0-or-later) shaders come from the user's own Lossless.dll.
+
+#ifdef NX_ZINK
+
+#define VK_NO_PROTOTYPES
+#define VK_USE_PLATFORM_VI_NN
+#include <vulkan/vulkan.h>
+
+#ifdef NX_ZINK_LSFG
+#include <lsfg-vk-backend/lsfgvk.hpp>
+#include <lsfg-vk-common/vulkan/command_buffer.hpp>
+#endif
+
+#include <switch.h>
+
+#include <chrono>
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <exception>
+#include <filesystem>
+#include <memory>
+
+extern "C" PFN_vkVoidFunction vk_icdGetInstanceProcAddr(VkInstance instance, const char *pName);
+extern "C" PFN_vkVoidFunction vk_common_GetDeviceProcAddr(VkDevice device, const char *pName);
+
+// Settings shared with the display server / menu (set from GDScript through ProjectSettings in display_server_switch).
+extern "C" {
+int nx_zink_swap_interval = 1; // 2 = 30 fps lock
+int nx_zink_fg_wanted = 0; // frame generation requested
+}
+
+namespace {
+
+void logf(const char *fmt, ...) {
+	va_list ap;
+	va_start(ap, fmt);
+	printf("[nx zink] ");
+	vprintf(fmt, ap);
+	printf("\n");
+	fflush(stdout);
+	va_end(ap);
+}
+
+struct Real {
+	PFN_vkCreateDevice CreateDevice = nullptr;
+	PFN_vkGetDeviceQueue GetDeviceQueue = nullptr;
+	PFN_vkCreateSwapchainKHR CreateSwapchainKHR = nullptr;
+	PFN_vkGetSwapchainImagesKHR GetSwapchainImagesKHR = nullptr;
+	PFN_vkQueuePresentKHR QueuePresentKHR = nullptr;
+	PFN_vkAcquireNextImageKHR AcquireNextImageKHR = nullptr;
+	PFN_vkCreateCommandPool CreateCommandPool = nullptr;
+	PFN_vkAllocateCommandBuffers AllocateCommandBuffers = nullptr;
+	PFN_vkBeginCommandBuffer BeginCommandBuffer = nullptr;
+	PFN_vkEndCommandBuffer EndCommandBuffer = nullptr;
+	PFN_vkResetCommandBuffer ResetCommandBuffer = nullptr;
+	PFN_vkCmdPipelineBarrier CmdPipelineBarrier = nullptr;
+	PFN_vkCmdBlitImage CmdBlitImage = nullptr;
+	PFN_vkCmdCopyImage CmdCopyImage = nullptr;
+	PFN_vkQueueSubmit QueueSubmit = nullptr;
+	PFN_vkCreateSemaphore CreateSemaphore = nullptr;
+	PFN_vkCreateFence CreateFence = nullptr;
+	PFN_vkWaitForFences WaitForFences = nullptr;
+	PFN_vkResetFences ResetFences = nullptr;
+} R;
+
+struct State {
+	VkInstance instance = VK_NULL_HANDLE;
+	VkPhysicalDevice phys = VK_NULL_HANDLE;
+	VkDevice device = VK_NULL_HANDLE;
+	VkQueue queue = VK_NULL_HANDLE;
+	uint32_t queue_family = 0;
+	VkSwapchainKHR swapchain = VK_NULL_HANDLE;
+	VkExtent2D extent{};
+	VkFormat format = VK_FORMAT_UNDEFINED;
+	uint32_t image_count = 0;
+	VkImage images[8]{};
+	std::chrono::steady_clock::time_point last_present{};
+	// frame generation
+	bool fg_failed = false;
+	bool fg_ready = false;
+	uint64_t frame = 0;
+	uint64_t gen_shown = 0;
+	VkCommandPool pool = VK_NULL_HANDLE;
+	VkCommandBuffer cmd[2]{}, cmd2[2]{};
+	VkFence fence[2]{};
+	VkSemaphore real_ready[2]{}, gen_acquired[2]{}, gen_ready[8]{};
+#ifdef NX_ZINK_LSFG
+	std::unique_ptr<lsfgvk::backend::Instance> lsfg;
+	lsfgvk::backend::Context *ctx = nullptr;
+#endif
+	uint32_t fg_w = 960, fg_h = 540;
+} S;
+
+PFN_vkVoidFunction real_gdpa(VkDevice d, const char *n) { return vk_common_GetDeviceProcAddr(d, n); }
+
+VKAPI_ATTR void VKAPI_CALL hook_GetDeviceQueue(VkDevice device, uint32_t family, uint32_t index, VkQueue *queue) {
+	R.GetDeviceQueue(device, family, index, queue);
+	if (device == S.device && !S.queue) {
+		S.queue = *queue;
+		S.queue_family = family;
+	}
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL hook_CreateDevice(VkPhysicalDevice phys, const VkDeviceCreateInfo *info, const VkAllocationCallbacks *alloc, VkDevice *device) {
+	VkResult r = R.CreateDevice(phys, info, alloc, device);
+	if (r == VK_SUCCESS) {
+		S.phys = phys;
+		S.device = *device;
+		logf("Zink device %p", (void *)*device);
+	}
+	return r;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL hook_CreateSwapchainKHR(VkDevice device, const VkSwapchainCreateInfoKHR *info, const VkAllocationCallbacks *alloc, VkSwapchainKHR *sc) {
+	VkSwapchainCreateInfoKHR ci = *info;
+	logf("Zink asks for %u swapchain images, present mode %d", info->minImageCount, (int)info->presentMode);
+	ci.presentMode = VK_PRESENT_MODE_FIFO_KHR;
+	ci.imageUsage |= VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+	ci.minImageCount = info->minImageCount + 1; // one image more than Zink plans for: the generated frame
+	VkResult r = R.CreateSwapchainKHR(device, &ci, alloc, sc);
+	if (r != VK_SUCCESS) {
+		logf("swapchain with extra image failed (%d), retrying as asked", (int)r);
+		ci.minImageCount = info->minImageCount;
+		r = R.CreateSwapchainKHR(device, &ci, alloc, sc);
+	}
+	if (r == VK_SUCCESS) {
+		S.swapchain = *sc;
+		S.extent = ci.imageExtent;
+		S.format = ci.imageFormat;
+		S.image_count = 8;
+		R.GetSwapchainImagesKHR(device, *sc, &S.image_count, S.images);
+		logf("swapchain %ux%u format %d, %u images", ci.imageExtent.width, ci.imageExtent.height, (int)ci.imageFormat, S.image_count);
+	}
+	return r;
+}
+
+void barrier(VkCommandBuffer c, VkImage img, VkImageLayout from, VkImageLayout to, VkAccessFlags src, VkAccessFlags dst) {
+	VkImageMemoryBarrier b{ VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER };
+	b.srcAccessMask = src;
+	b.dstAccessMask = dst;
+	b.oldLayout = from;
+	b.newLayout = to;
+	b.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+	b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+	b.image = img;
+	b.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+	R.CmdPipelineBarrier(c, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, nullptr, 0, nullptr, 1, &b);
+}
+
+void blit(VkCommandBuffer c, VkImage src, VkImageLayout src_layout, VkExtent2D se, VkImage dst, VkImageLayout dst_layout, VkExtent2D de) {
+	VkImageBlit r{};
+	r.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+	r.srcOffsets[1] = { (int32_t)se.width, (int32_t)se.height, 1 };
+	r.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+	r.dstOffsets[1] = { (int32_t)de.width, (int32_t)de.height, 1 };
+	R.CmdBlitImage(c, src, src_layout, dst, dst_layout, 1, &r, VK_FILTER_LINEAR);
+}
+
+// 1:1 image copy when the sizes match (cheaper, and no filtering), else a scaled blit.
+void move(VkCommandBuffer c, VkImage src, VkImageLayout src_layout, VkExtent2D se, VkImage dst, VkImageLayout dst_layout, VkExtent2D de) {
+	if (se.width == de.width && se.height == de.height && S.format == VK_FORMAT_R8G8B8A8_UNORM) {
+		VkImageCopy r{};
+		r.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+		r.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+		r.extent = { se.width, se.height, 1 };
+		R.CmdCopyImage(c, src, src_layout, dst, dst_layout, 1, &r);
+	} else {
+		blit(c, src, src_layout, se, dst, dst_layout, de);
+	}
+}
+
+void pace() {
+	// 30 fps lock (FIFO presents one image per VBlank at most; wait so a frame stays on screen two of them).
+	if (nx_zink_swap_interval >= 2 && S.last_present.time_since_epoch().count()) {
+		const auto target = S.last_present + std::chrono::microseconds(33000 * (nx_zink_swap_interval - 1));
+		const auto now = std::chrono::steady_clock::now();
+		if (now < target) {
+			svcSleepThread(std::chrono::duration_cast<std::chrono::nanoseconds>(target - now).count());
+		}
+	}
+	S.last_present = std::chrono::steady_clock::now();
+}
+
+#ifdef NX_ZINK_LSFG
+bool fg_init() {
+	if (S.fg_ready || S.fg_failed) {
+		return S.fg_ready;
+	}
+	S.fg_failed = true; // until proven otherwise
+	if (!S.queue || !S.swapchain) {
+		return false;
+	}
+	if (S.extent.width && S.extent.height && S.extent.width <= 1280) { // handheld 720p; on a 1080p TV stay at 960x540
+		S.fg_w = S.extent.width; // same size as the swapchain: plain copies in and out, no scaling
+		S.fg_h = S.extent.height;
+	}
+	const char *dll = nullptr;
+	for (const char *p : { "sdmc:/switch/buckshot_roulette/Lossless.dll", "sdmc:/switch/pt/lsfg/Lossless.dll", "sdmc:/Lossless.dll" }) {
+		if (FILE *t = fopen(p, "rb")) {
+			fclose(t);
+			dll = p;
+			break;
+		}
+	}
+	if (!dll) {
+		logf("Lossless.dll not found: frame generation off");
+		return false;
+	}
+	try {
+		lsfgvk::backend::BorrowedDevice bd{};
+		bd.instance = S.instance;
+		bd.physicalDevice = S.phys;
+		bd.device = S.device;
+		bd.queueFamilyIndex = S.queue_family;
+		bd.queue = S.queue;
+		bd.getInstanceProcAddr = (PFN_vkGetInstanceProcAddr)vk_icdGetInstanceProcAddr;
+		auto t0 = std::chrono::steady_clock::now();
+		S.lsfg = std::make_unique<lsfgvk::backend::Instance>(bd, std::filesystem::path(dll), true);
+		S.ctx = &S.lsfg->openLocalContext(S.fg_w, S.fg_h, false, 2.0f, true, 1);
+		logf("lsfg ready on Zink's device in %.0f ms (%ux%u, %s)",
+				std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count(), S.fg_w, S.fg_h, dll);
+	} catch (const std::exception &e) {
+		logf("lsfg unavailable: %s", e.what());
+		return false;
+	}
+	VkCommandPoolCreateInfo pci{ VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO };
+	pci.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+	pci.queueFamilyIndex = S.queue_family;
+	R.CreateCommandPool(S.device, &pci, nullptr, &S.pool);
+	VkCommandBufferAllocateInfo cai{ VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO };
+	cai.commandPool = S.pool;
+	cai.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+	cai.commandBufferCount = 2;
+	R.AllocateCommandBuffers(S.device, &cai, S.cmd);
+	R.AllocateCommandBuffers(S.device, &cai, S.cmd2);
+	VkFenceCreateInfo fci{ VK_STRUCTURE_TYPE_FENCE_CREATE_INFO };
+	fci.flags = VK_FENCE_CREATE_SIGNALED_BIT;
+	VkSemaphoreCreateInfo sci{ VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO };
+	for (int i = 0; i < 2; i++) {
+		R.CreateFence(S.device, &fci, nullptr, &S.fence[i]);
+		R.CreateSemaphore(S.device, &sci, nullptr, &S.real_ready[i]);
+		R.CreateSemaphore(S.device, &sci, nullptr, &S.gen_acquired[i]);
+	}
+	for (uint32_t i = 0; i < S.image_count; i++) {
+		R.CreateSemaphore(S.device, &sci, nullptr, &S.gen_ready[i]);
+	}
+	S.fg_failed = false;
+	S.fg_ready = true;
+	return true;
+}
+
+// Frame generation around Zink's present of `idx`. nxvk checks out one swapchain image at a time, so the generated frame
+// goes into Zink's own image (presented first) and the real frame into the next image acquired after that.
+// The real frame is shown from lsfg's source copy (swapchain size up to 720p; 960x540 on a 1080p TV).
+bool fg_present(VkQueue queue, const VkPresentInfoKHR *info, uint32_t idx) {
+	const int s = (int)(S.frame & 1);
+	R.WaitForFences(S.device, 1, &S.fence[s], VK_TRUE, UINT64_MAX);
+	R.ResetFences(S.device, 1, &S.fence[s]);
+	VkImage zimg = S.images[idx];
+	const VkExtent2D fge{ S.fg_w, S.fg_h };
+	const bool have_gen = S.frame >= 1; // lsfg needs two source frames
+	VkPipelineStageFlags stages[8];
+	for (int i = 0; i < 8; i++) {
+		stages[i] = VK_PIPELINE_STAGE_ALL_COMMANDS_BIT;
+	}
+	VkCommandBufferBeginInfo bi{ VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO };
+	bi.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+	try {
+		VkImage src = S.lsfg->sourceImage(*S.ctx, S.frame & 1);
+		VkImage gen = S.lsfg->destinationImage(*S.ctx, 0);
+		// submit 1: Zink's frame -> lsfg source, lsfg passes, then (if any) the generated frame into Zink's image
+		VkCommandBuffer c = S.cmd[s];
+		R.ResetCommandBuffer(c, 0);
+		R.BeginCommandBuffer(c, &bi);
+		barrier(c, zimg, VK_IMAGE_LAYOUT_PRESENT_SRC_KHR, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_ACCESS_MEMORY_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT);
+		move(c, zimg, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, S.extent, src, VK_IMAGE_LAYOUT_GENERAL, fge);
+		VkMemoryBarrier mb{ VK_STRUCTURE_TYPE_MEMORY_BARRIER };
+		mb.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT | VK_ACCESS_TRANSFER_READ_BIT;
+		mb.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+		R.CmdPipelineBarrier(c, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 1, &mb, 0, nullptr, 0, nullptr);
+		S.lsfg->recordFrame(*S.ctx, vk::CommandBuffer(c));
+		if (have_gen) {
+			mb.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+			mb.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+			R.CmdPipelineBarrier(c, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 1, &mb, 0, nullptr, 0, nullptr);
+			barrier(c, zimg, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_ACCESS_TRANSFER_READ_BIT, VK_ACCESS_TRANSFER_WRITE_BIT);
+			move(c, gen, VK_IMAGE_LAYOUT_GENERAL, fge, zimg, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, S.extent);
+			barrier(c, zimg, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_PRESENT_SRC_KHR, VK_ACCESS_TRANSFER_WRITE_BIT, 0);
+		} else {
+			barrier(c, zimg, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_IMAGE_LAYOUT_PRESENT_SRC_KHR, VK_ACCESS_TRANSFER_READ_BIT, 0);
+		}
+		R.EndCommandBuffer(c);
+		VkSubmitInfo si{ VK_STRUCTURE_TYPE_SUBMIT_INFO };
+		si.waitSemaphoreCount = info->waitSemaphoreCount;
+		si.pWaitSemaphores = info->pWaitSemaphores;
+		si.pWaitDstStageMask = stages;
+		si.commandBufferCount = 1;
+		si.pCommandBuffers = &c;
+		si.signalSemaphoreCount = 1;
+		si.pSignalSemaphores = &S.real_ready[s];
+		if (R.QueueSubmit(queue, 1, &si, have_gen ? VK_NULL_HANDLE : S.fence[s]) != VK_SUCCESS) {
+			return false;
+		}
+		// present Zink's image: the generated frame (or, on the first frame, the real one)
+		VkPresentInfoKHR p = *info;
+		p.waitSemaphoreCount = 1;
+		p.pWaitSemaphores = &S.real_ready[s];
+		R.QueuePresentKHR(queue, &p);
+
+		if (have_gen) {
+			// submit 2: the real frame into the next image (nothing is checked out now), presented one VBlank later
+			uint32_t ri = 0;
+			const VkResult ar = R.AcquireNextImageKHR(S.device, S.swapchain, 100000000ull, S.gen_acquired[s], VK_NULL_HANDLE, &ri);
+			static int ar_logged = 0;
+			if (ar_logged < 3) {
+				ar_logged++;
+				logf("acquire for the real frame: %d (image %u)", (int)ar, ri);
+			}
+			if (ar == VK_SUCCESS || ar == VK_SUBOPTIMAL_KHR) {
+				VkCommandBuffer c2 = S.cmd2[s];
+				R.ResetCommandBuffer(c2, 0);
+				R.BeginCommandBuffer(c2, &bi);
+				barrier(c2, S.images[ri], VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 0, VK_ACCESS_TRANSFER_WRITE_BIT);
+				move(c2, src, VK_IMAGE_LAYOUT_GENERAL, fge, S.images[ri], VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, S.extent);
+				barrier(c2, S.images[ri], VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_PRESENT_SRC_KHR, VK_ACCESS_TRANSFER_WRITE_BIT, 0);
+				R.EndCommandBuffer(c2);
+				VkSubmitInfo s2{ VK_STRUCTURE_TYPE_SUBMIT_INFO };
+				s2.waitSemaphoreCount = 1;
+				s2.pWaitSemaphores = &S.gen_acquired[s];
+				s2.pWaitDstStageMask = stages;
+				s2.commandBufferCount = 1;
+				s2.pCommandBuffers = &c2;
+				s2.signalSemaphoreCount = 1;
+				s2.pSignalSemaphores = &S.gen_ready[ri];
+				if (R.QueueSubmit(queue, 1, &s2, S.fence[s]) == VK_SUCCESS) {
+					VkPresentInfoKHR p2{ VK_STRUCTURE_TYPE_PRESENT_INFO_KHR };
+					p2.waitSemaphoreCount = 1;
+					p2.pWaitSemaphores = &S.gen_ready[ri];
+					p2.swapchainCount = 1;
+					p2.pSwapchains = &S.swapchain;
+					p2.pImageIndices = &ri;
+					R.QueuePresentKHR(queue, &p2);
+					S.gen_shown++;
+				}
+			} else {
+				VkSubmitInfo s0{ VK_STRUCTURE_TYPE_SUBMIT_INFO };
+				R.QueueSubmit(queue, 1, &s0, S.fence[s]);
+			}
+		}
+	} catch (const std::exception &e) {
+		logf("frame generation failed: %s", e.what());
+		S.fg_failed = true;
+		S.fg_ready = false;
+		return false;
+	}
+	S.frame++;
+	if (S.frame <= 3 || S.frame % 900 == 0) {
+		logf("frame %llu: %llu generated frames shown so far", (unsigned long long)S.frame, (unsigned long long)S.gen_shown);
+	}
+	return true;
+}
+#endif
+
+VKAPI_ATTR VkResult VKAPI_CALL hook_QueuePresentKHR(VkQueue queue, const VkPresentInfoKHR *info) {
+#ifdef NX_ZINK_LSFG
+	// With frame generation the two presents per frame already hold the game at 30.
+	if (!(nx_zink_fg_wanted && S.fg_ready)) {
+		pace();
+	}
+	if (nx_zink_fg_wanted && info->swapchainCount == 1 && info->pSwapchains[0] == S.swapchain && fg_init()) {
+		if (fg_present(queue, info, info->pImageIndices[0])) {
+			if (info->pResults) {
+				info->pResults[0] = VK_SUCCESS;
+			}
+			return VK_SUCCESS;
+		}
+	}
+#else
+	pace();
+#endif
+	return R.QueuePresentKHR(queue, info);
+}
+
+} // namespace
+
+extern "C" PFN_vkVoidFunction nx_hook_GetDeviceProcAddr(VkDevice device, const char *name);
+
+extern "C" PFN_vkVoidFunction nx_hook_GetInstanceProcAddr(VkInstance instance, const char *name) {
+	PFN_vkVoidFunction f = vk_icdGetInstanceProcAddr(instance, name);
+	if (!name || !f) {
+		return f;
+	}
+	if (instance && !S.instance) {
+		S.instance = instance;
+	}
+	if (!strcmp(name, "vkCreateDevice")) {
+		R.CreateDevice = (PFN_vkCreateDevice)f;
+		return (PFN_vkVoidFunction)hook_CreateDevice;
+	}
+	if (!strcmp(name, "vkGetDeviceProcAddr")) {
+		return (PFN_vkVoidFunction)nx_hook_GetDeviceProcAddr;
+	}
+	// device-level entry points looked up through the instance
+	if (!strcmp(name, "vkQueuePresentKHR")) {
+		R.QueuePresentKHR = (PFN_vkQueuePresentKHR)f;
+		return (PFN_vkVoidFunction)hook_QueuePresentKHR;
+	}
+	if (!strcmp(name, "vkCreateSwapchainKHR")) {
+		R.CreateSwapchainKHR = (PFN_vkCreateSwapchainKHR)f;
+		return (PFN_vkVoidFunction)hook_CreateSwapchainKHR;
+	}
+	if (!strcmp(name, "vkGetDeviceQueue")) {
+		R.GetDeviceQueue = (PFN_vkGetDeviceQueue)f;
+		return (PFN_vkVoidFunction)hook_GetDeviceQueue;
+	}
+	return f;
+}
+
+extern "C" PFN_vkVoidFunction nx_hook_GetDeviceProcAddr(VkDevice device, const char *name) {
+	PFN_vkVoidFunction f = real_gdpa(device, name);
+	if (!name || !f) {
+		return f;
+	}
+	if (device && !R.QueueSubmit) {
+#define L(n) R.n = (PFN_vk##n)real_gdpa(device, "vk" #n);
+		L(GetDeviceQueue)
+		L(CreateSwapchainKHR)
+		L(GetSwapchainImagesKHR)
+		L(QueuePresentKHR)
+		L(AcquireNextImageKHR)
+		L(CreateCommandPool)
+		L(AllocateCommandBuffers)
+		L(BeginCommandBuffer)
+		L(EndCommandBuffer)
+		L(ResetCommandBuffer)
+		L(CmdPipelineBarrier)
+		L(CmdBlitImage)
+		L(CmdCopyImage)
+		L(QueueSubmit)
+		L(CreateSemaphore)
+		L(CreateFence)
+		L(WaitForFences)
+		L(ResetFences)
+#undef L
+	}
+	if (!strcmp(name, "vkGetDeviceQueue")) {
+		return (PFN_vkVoidFunction)hook_GetDeviceQueue;
+	}
+	if (!strcmp(name, "vkCreateSwapchainKHR")) {
+		return (PFN_vkVoidFunction)hook_CreateSwapchainKHR;
+	}
+	if (!strcmp(name, "vkQueuePresentKHR")) {
+		return (PFN_vkVoidFunction)hook_QueuePresentKHR;
+	}
+	return f;
+}
+
+#endif // NX_ZINK
diff --git a/platform/switch/os_switch.cpp b/platform/switch/os_switch.cpp
new file mode 100644
index 0000000..b33d013
--- /dev/null
+++ b/platform/switch/os_switch.cpp
@@ -0,0 +1,112 @@
+#include "os_switch.h"
+
+#include "display_server_switch.h"
+
+#include "core/config/project_settings.h"
+#include "core/io/dir_access.h"
+#include "main/main.h"
+#include "servers/audio_server.h"
+
+#include "nx.h"
+
+#include <sys/stat.h>
+
+OS_Switch::OS_Switch(const char *p_argv0) {
+	exe_path = String::utf8(p_argv0 ? p_argv0 : "");
+	if (exe_path.is_empty() || !exe_path.contains("/")) {
+		exe_path = "sdmc:/switch/buckshot_roulette/buckshot_roulette.nro";
+	}
+	base_dir = exe_path.get_base_dir();
+	AudioDriverManager::add_driver(&audio_driver);
+}
+
+void OS_Switch::initialize() {
+	OS_Unix::initialize_core();
+	DisplayServerSwitch::register_switch_driver();
+
+	// Core types are not registered yet: use plain libc here.
+	mkdir(get_user_data_dir().utf8().get_data(), 0777);
+	mkdir(get_cache_path().utf8().get_data(), 0777);
+}
+
+void OS_Switch::set_main_loop(MainLoop *p_main_loop) {
+	main_loop = p_main_loop;
+}
+
+void OS_Switch::delete_main_loop() {
+	if (main_loop) {
+		memdelete(main_loop);
+	}
+	main_loop = nullptr;
+}
+
+void OS_Switch::finalize() {
+	delete_main_loop();
+}
+
+bool OS_Switch::_check_internal_feature_support(const String &p_feature) {
+	return p_feature == "mobile" || p_feature == "switch" || p_feature == "nx" || p_feature == "etc2" || p_feature == "s3tc" || p_feature == "bptc";
+}
+
+String OS_Switch::get_version() const {
+	SetSysFirmwareVersion fw;
+	if (R_SUCCEEDED(setsysGetFirmwareVersion(&fw))) {
+		return String::utf8(fw.display_version);
+	}
+	return "";
+}
+
+String OS_Switch::get_locale() const {
+	u64 code = 0;
+	SetLanguage lang = SetLanguage_ENUS;
+	if (R_SUCCEEDED(setGetSystemLanguage(&code)) && R_SUCCEEDED(setMakeLanguage(code, &lang))) {
+		switch (lang) {
+			case SetLanguage_JA: return "ja";
+			case SetLanguage_FR: case SetLanguage_FRCA: return "fr";
+			case SetLanguage_DE: return "de";
+			case SetLanguage_IT: return "it";
+			case SetLanguage_ES: case SetLanguage_ES419: return "es";
+			case SetLanguage_ZHCN: case SetLanguage_ZHHANS: return "zh_CN";
+			case SetLanguage_ZHTW: case SetLanguage_ZHHANT: return "zh_TW";
+			case SetLanguage_KO: return "ko";
+			case SetLanguage_NL: return "nl";
+			case SetLanguage_PT: case SetLanguage_PTBR: return "pt";
+			case SetLanguage_RU: return "ru";
+			default: return "en";
+		}
+	}
+	return "en";
+}
+
+Dictionary OS_Switch::get_memory_info() const {
+	Dictionary meminfo;
+	u64 total = 0, used = 0;
+	svcGetInfo(&total, InfoType_TotalMemorySize, CUR_PROCESS_HANDLE, 0);
+	svcGetInfo(&used, InfoType_UsedMemorySize, CUR_PROCESS_HANDLE, 0);
+	meminfo["physical"] = (int64_t)total;
+	meminfo["free"] = (int64_t)(total - used);
+	meminfo["available"] = (int64_t)(total - used);
+	meminfo["stack"] = -1;
+	return meminfo;
+}
+
+Error OS_Switch::get_entropy(uint8_t *r_buffer, int p_bytes) {
+	randomGet(r_buffer, p_bytes);
+	return OK;
+}
+
+void OS_Switch::run() {
+	if (!main_loop) {
+		return;
+	}
+	main_loop->initialize();
+	int it = 0;
+	while (appletMainLoop()) {
+		it++;
+		DisplayServer::get_singleton()->process_events();
+		if (Main::iteration()) {
+			break;
+		}
+	}
+	main_loop->finalize();
+}
