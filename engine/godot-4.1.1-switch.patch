+bool DisplayServerSwitch::has_feature(Feature p_feature) const {
+	switch (p_feature) {
+		case FEATURE_TOUCHSCREEN:
+		case FEATURE_MOUSE:
+			return true;
+		default:
+			return false;
+	}
+}
