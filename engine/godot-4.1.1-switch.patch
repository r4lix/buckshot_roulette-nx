diff --git a/platform/switch/detect.py b/platform/switch/detect.py
new file mode 100644
index 0000000..c34f3a7
--- /dev/null
+++ b/platform/switch/detect.py
@@ -0,0 +1,144 @@
+import os
+import sys
+
+from typing import TYPE_CHECKING
+
+if TYPE_CHECKING:
+    from SCons import Environment
+
+
+def get_dkp():
+    d = os.environ.get("DEVKITPRO", "")
+    if not d or d.startswith("/opt"):
+        # Windows host: msys-style DEVKITPRO is useless to native Python.
+        for c in ["C:/devkitPro", "C:\\devkitPro"]:
+            if os.path.isdir(c):
+                return c.replace("\\", "/")
+    return d
+
+
+def get_name():
+    return "Switch"
+
+
+def can_build():
+    return os.path.isdir(get_dkp() + "/libnx")
+
+
+def get_opts():
+    from SCons.Variables import BoolVariable
+
+    return [
+        BoolVariable("zink", "GL on nxvk's Zink (OpenGL over Vulkan); no = devkitPro's Mesa nouveau GL", True),
+        BoolVariable("lsfg", "LSFG frame generation in the Zink build (needs the user's Lossless.dll at runtime)", True),
+    ]
+
+
+def get_flags():
+    return [
+        ("arch", "arm64"),
+        ("target", "template_release"),
+        ("vulkan", False),
+        ("use_volk", True),
+        ("opengl3", True),
+        ("openxr", False),
+        ("builtin_pcre2_with_jit", False),
+        ("module_mono_enabled", False),
+        ("module_upnp_enabled", False),
+        ("module_webrtc_enabled", False),
+        ("module_websocket_enabled", False),
+        ("module_mbedtls_enabled", False),
+        ("module_text_server_adv_enabled", True),
+        ("module_text_server_fb_enabled", False),
+        ("module_camera_enabled", False),
+        ("module_raycast_enabled", False),
+        ("module_denoise_enabled", False),
+        ("module_lightmapper_rd_enabled", False),
+        ("module_theora_enabled", True),
+        ("module_navigation_enabled", True),
+    ]
+
+
+def configure(env: "Environment"):
+    if env["arch"] != "arm64":
+        print("Switch only supports arm64")
+        sys.exit(255)
+
+    dkp = get_dkp()
+    a64 = dkp + "/devkitA64/bin/aarch64-none-elf-"
+    exe = ".exe" if os.name == "nt" else ""
+    env["CC"] = a64 + "gcc" + exe
+    env["CXX"] = a64 + "g++" + exe
+    env["LINK"] = a64 + "g++" + exe
+    env["AR"] = a64 + "gcc-ar" + exe
+    env["RANLIB"] = a64 + "gcc-ranlib" + exe
+    env["AS"] = a64 + "as" + exe
+    env["ENV"]["DEVKITPRO"] = dkp
+    env["PROGSUFFIX"] = ".elf"
+    env["ENV"]["PATH"] = dkp + "/devkitA64/bin" + os.pathsep + env["ENV"]["PATH"]
+    # Long command lines on Windows.
+    # Windows' 32K command-line limit: pass long ar/link lines through response files.
+    # GNU tools treat backslashes in @files as escapes, so use forward slashes.
+    env["MAXLINELENGTH"] = 8000
+    env["TEMPFILEARGESCFUNC"] = lambda arg: str(arg).replace("\\", "/")
+    env["ARCOM"] = "${TEMPFILE('$AR $ARFLAGS $TARGET $SOURCES','$ARCOMSTR')}"
+    # nxvk goes between the objects and the libraries: whole archive for the driver, then its support libs.
+    env["NXVK_LINK"] = ""
+    env["LINKCOM"] = "${TEMPFILE('$LINK -o $TARGET $LINKFLAGS $__RPATH $SOURCES $_LIBDIRFLAGS $NXVK_LINK $_LIBFLAGS','$LINKCOMSTR')}"
+
+    arch = ["-march=armv8-a+crc+crypto", "-mtune=cortex-a57", "-mtp=soft", "-fPIE"]
+    env.Append(CCFLAGS=arch + ["-ffunction-sections", "-fdata-sections"])
+    env.Append(CPPDEFINES=["__SWITCH__", "HORIZON_ENABLED", "UNIX_ENABLED", "PTHREAD_NO_RENAME"])
+    env.Append(CPPPATH=[dkp + "/libnx/include", dkp + "/portlibs/switch/include", "#platform/switch", "#platform/switch/compat"])
+    env.Append(LIBPATH=[dkp + "/libnx/lib", dkp + "/portlibs/switch/lib"])
+    env.Append(LINKFLAGS=arch + ["-specs=" + dkp + "/libnx/switch.specs", "-Wl,--gc-sections"])
+    # Mesa GL (devkitPro) and nxvk each carry their own Mesa: one or the other per build.
+    if env["opengl3"]:
+        env.Append(CPPDEFINES=["GLES3_ENABLED"])
+        if not env["zink"]:
+            env.Append(LIBS=["EGL", "GLESv2", "glapi", "drm_nouveau"])
+        if env["vulkan"]:
+            print("Switch: build either vulkan=yes or opengl3=yes, not both (two Mesa copies clash)")
+            sys.exit(255)
+    env.Append(LIBS=["nx", "pthread", "m"])
+
+    if env["zink"]:
+        # OpenGL from nxvk: Zink (Gallium GL over Vulkan) + EGL + NVK, all static (nxvk-gl portlib layout).
+        if env["vulkan"] or not env["opengl3"]:
+            print("Switch: zink=yes needs opengl3=yes vulkan=no")
+            sys.exit(255)
+        here = os.path.dirname(os.path.abspath(__file__)).replace("\\", "/")
+        gl = os.environ.get("NXVK_GL_PKG", here + "/../../../../nxvk-pkg-gl").replace("\\", "/")  # default: next to the repo
+        expat = here + "/../../../third_party/nxvk"
+        # libnvk_gl_hooked.a: libnvk_gl.a with Zink's two Vulkan entry points renamed to nx_hook_* (nx_zink_hook.cpp):
+        #   objcopy --redefine-sym vk_icdGetInstanceProcAddr=nx_hook_GetInstanceProcAddr
+        #           --redefine-sym vk_common_GetDeviceProcAddr=nx_hook_GetDeviceProcAddr libnvk_gl.a libnvk_gl_hooked.a
+        if not os.path.isfile(gl + "/lib/libnvk_gl_hooked.a"):
+            print("nxvk-gl package (libnvk_gl_hooked.a) not found at %s (set NXVK_GL_PKG)" % gl)
+            sys.exit(255)
+        env.Append(CPPDEFINES=["NX_ZINK"])
+        if env["lsfg"]:
+            env.Append(CPPDEFINES=["NX_ZINK_LSFG"])
+        env["NXVK_LINK"] = ("-L%s/lib -L%s -Wl,--whole-archive -lnvk_gl_hooked -lnvk -Wl,--no-whole-archive "
+                            "-Wl,--start-group -lnvk_support -lz -lexpat -Wl,--end-group -Wl,-u,vk_icdGetInstanceProcAddr") % (gl, expat)
+
+    if env["lsfg"] and not env["zink"]:
+        # The nouveau GL build has no way to hand frames to Vulkan without a full stall: frame generation is Zink only.
+        env["lsfg"] = False
+
+    if env["vulkan"]:
+        # Experimental, unmaintained: Godot's Mobile renderer on nxvk (Environment fog hangs, slower than GL). Needs zink=no.
+        env.Append(CPPDEFINES=["VULKAN_ENABLED"])
+        # nxvk (Mesa NVK for the Switch, GPL-2.0-or-later, github.com/PalindromicBreadLoaf/nxvk), linked statically.
+        here = os.path.dirname(os.path.abspath(__file__)).replace("\\", "/")
+        nxvk = os.environ.get("NXVK_PKG", here + "/../../../../nxvk-pkg").replace("\\", "/")
+        expat = here + "/../../../third_party/nxvk"
+        if not os.path.isfile(nxvk + "/lib/libnvk.a"):
+            print("nxvk package not found at %s (set NXVK_PKG), or build with vulkan=no" % nxvk)
+            sys.exit(255)
+        env["NXVK_LINK"] = ("-L%s/lib -L%s -Wl,--whole-archive -lnvk -Wl,--no-whole-archive "
+                            "-Wl,--start-group -lnvk_support -lz -Wl,--end-group -lexpat -Wl,-u,vk_icdGetInstanceProcAddr") % (nxvk, expat)
+
+    # Thread-safe statics etc. come from newlib + libnx pthreads.
+    env.Append(CCFLAGS=["-Wno-psabi"])
+    env.Append(CXXFLAGS=["-Wno-template-id-cdtor"])
diff --git a/platform/switch/display_server_switch.cpp b/platform/switch/display_server_switch.cpp
