index 0000000..46a3965
--- /dev/null
+++ b/platform/switch/display_server_switch.cpp
@@ -0,0 +1,504 @@
+#include "display_server_switch.h"
+
+#include "core/config/project_settings.h"
+#include "core/input/input.h"
+#include "core/os/os.h"
+#include "core/os/time.h"
+#include "core/io/file_access.h"
+#include "scene/resources/texture.h"
+
+#ifdef GLES3_ENABLED
+#include "drivers/gles3/rasterizer_gles3.h"
+#endif
+#include "servers/rendering/dummy/rasterizer_dummy.h"
+
+#ifdef VULKAN_ENABLED
+#include "drivers/vulkan/rendering_device_vulkan.h"
+#include "servers/rendering/renderer_rd/renderer_compositor_rd.h"
+#include "vulkan_context_switch.h"
+#endif
+
+
+static DisplayServerSwitch *ds_singleton = nullptr;
+
+// Nintendo layout: A (right) confirms, B (bottom) cancels. Godot's JoyButton::A is "confirm".
+static const struct {
+	u64 mask;
+	JoyButton button;
+} button_map[] = {
+	{ HidNpadButton_A, JoyButton::A },
+	{ HidNpadButton_B, JoyButton::B },
+	{ HidNpadButton_Y, JoyButton::X },
+	{ HidNpadButton_X, JoyButton::Y },
+	{ HidNpadButton_Minus, JoyButton::BACK },
+	{ HidNpadButton_Plus, JoyButton::START },
+	{ HidNpadButton_StickL, JoyButton::LEFT_STICK },
+	{ HidNpadButton_StickR, JoyButton::RIGHT_STICK },
+	{ HidNpadButton_L, JoyButton::LEFT_SHOULDER },
+	{ HidNpadButton_R, JoyButton::RIGHT_SHOULDER },
+	{ HidNpadButton_Up, JoyButton::DPAD_UP },
+	{ HidNpadButton_Down, JoyButton::DPAD_DOWN },
+	{ HidNpadButton_Left, JoyButton::DPAD_LEFT },
+	{ HidNpadButton_Right, JoyButton::DPAD_RIGHT },
+};
+
+void DisplayServerSwitch::_dispatch_input_event(const Ref<InputEvent> &p_event) {
+	if (!ds_singleton) {
+		return;
+	}
+	Callable cb = ds_singleton->input_event_callback;
+	if (!cb.is_null()) {
+		Variant ev = p_event;
+		Variant *evp = &ev;
+		Variant ret;
+		Callable::CallError ce;
+		cb.callp((const Variant **)&evp, 1, ret, ce);
+	}
+}
+
+void DisplayServerSwitch::_send_window_event(WindowEvent p_event) {
+	if (!window_event_callback.is_null()) {
+		Variant event = int(p_event);
+		Variant *eventp = &event;
+		Variant ret;
+		Callable::CallError ce;
+		window_event_callback.callp((const Variant **)&eventp, 1, ret, ce);
+	}
+}
+
+void DisplayServerSwitch::_applet_hook(AppletHookType p_hook, void *p_param) {
+	DisplayServerSwitch *ds = (DisplayServerSwitch *)p_param;
+	if (p_hook == AppletHookType_OnFocusState) {
+		bool now = appletGetFocusState() == AppletFocusState_InFocus;
+		if (now != ds->focused) {
+			ds->focused = now;
+			ds->_send_window_event(now ? WINDOW_EVENT_FOCUS_IN : WINDOW_EVENT_FOCUS_OUT);
+		}
+	} else if (p_hook == AppletHookType_OnExitRequest) {
+		ds->_send_window_event(WINDOW_EVENT_CLOSE_REQUEST);
+	}
+}
+
+#ifdef GLES3_ENABLED
+bool DisplayServerSwitch::_init_egl() {
+#ifdef NX_ZINK
+	// GL is Zink on nxvk: NVK still refuses to create a device without this.
+	setenv("NVK_I_WANT_A_BROKEN_VULKAN_DRIVER", "1", 1);
+#ifdef NX_ZINK_LSFG
+	{
+		// Frame generation is on unless the menu turned it off (it creates nx_lsfg_off); it also needs Lossless.dll.
+		extern int nx_zink_fg_wanted;
+		FILE *f = fopen("sdmc:/switch/buckshot_roulette/nx_lsfg_off", "r");
+		nx_zink_fg_wanted = f ? 0 : 1;
+		if (f) {
+			fclose(f);
+		}
+		printf("[nx] Zink build, frame generation %s\n", nx_zink_fg_wanted ? "on" : "off (nx_lsfg_off)");
+	}
+#endif
+#endif
+	egl_display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+	if (egl_display == EGL_NO_DISPLAY || !eglInitialize(egl_display, nullptr, nullptr)) {
+		return false;
+	}
+	if (!eglBindAPI(EGL_OPENGL_ES_API)) {
+		return false;
+	}
+	const EGLint cfg_attrs[] = {
+		EGL_RENDERABLE_TYPE, EGL_OPENGL_ES3_BIT,
+		EGL_SURFACE_TYPE, EGL_WINDOW_BIT,
+		EGL_RED_SIZE, 8, EGL_GREEN_SIZE, 8, EGL_BLUE_SIZE, 8, EGL_ALPHA_SIZE, 8,
+		EGL_DEPTH_SIZE, 24, EGL_STENCIL_SIZE, 8,
+		EGL_NONE
+	};
+	EGLConfig cfg;
+	EGLint n = 0;
+	if (!eglChooseConfig(egl_display, cfg_attrs, &cfg, 1, &n) || n == 0) {
+		return false;
+	}
+	NWindow *win = nwindowGetDefault();
+	nwindowSetDimensions(win, size.x, size.y);
+	egl_surface = eglCreateWindowSurface(egl_display, cfg, win, nullptr);
+	if (egl_surface == EGL_NO_SURFACE) {
+		return false;
+	}
+	static const EGLint ctx_attrs[] = {
+		EGL_CONTEXT_MAJOR_VERSION, 3,
+		EGL_CONTEXT_MINOR_VERSION, 2,
+		EGL_NONE
+	};
+	egl_context = eglCreateContext(egl_display, cfg, EGL_NO_CONTEXT, ctx_attrs);
+	if (egl_context == EGL_NO_CONTEXT) {
+		return false;
+	}
+	eglMakeCurrent(egl_display, egl_surface, egl_surface, egl_context);
+	return true;
+}
+#endif
+
+DisplayServerSwitch::DisplayServerSwitch(const String &p_rendering_driver, WindowMode p_window_mode, VSyncMode p_vsync_mode, uint32_t p_flags, const Point2i *p_position, const Size2i &p_resolution, int p_screen, Error &r_error) {
+	ds_singleton = this;
+	r_error = OK;
+
+	// Render at 1080p when docked, 720p handheld. The resolution is fixed at startup.
+	size = appletGetOperationMode() == AppletOperationMode_Console ? Size2i(1920, 1080) : Size2i(1280, 720);
+
+	padConfigureInput(1, HidNpadStyleSet_NpadStandard);
+	padInitializeDefault(&pad);
+	hidInitializeTouchScreen();
+	appletHook(&applet_cookie, _applet_hook, this);
+	appletSetFocusHandlingMode(AppletFocusHandlingMode_SuspendHomeSleepNotify);
+
+	rendering_driver = p_rendering_driver;
+	bool ok = false;
+#ifdef VULKAN_ENABLED
+	if (p_rendering_driver == "vulkan") {
+		NWindow *win = nwindowGetDefault();
+		nwindowSetDimensions(win, size.x, size.y);
+		context_vulkan = memnew(VulkanContextSwitch);
+		if (context_vulkan->initialize() != OK || context_vulkan->window_create(win, p_vsync_mode, size.x, size.y) != OK) {
+			memdelete(context_vulkan);
+			context_vulkan = nullptr;
+		} else {
+			rendering_device_vulkan = memnew(RenderingDeviceVulkan);
+			rendering_device_vulkan->initialize(context_vulkan);
+			RendererCompositorRD::make_current();
+			ok = true;
+		}
+	}
+#endif
+#ifdef GLES3_ENABLED
+	if (p_rendering_driver == "opengl3" && _init_egl()) {
+		RasterizerGLES3::make_current();
+		window_set_vsync_mode(p_vsync_mode);
+		ok = true;
+	}
+#endif
+	if (!ok) {
+		OS::get_singleton()->alert("Could not initialize the " + p_rendering_driver + " video driver.", "Video driver error");
+		r_error = ERR_UNAVAILABLE;
+		return;
+	}
+
+	cursor_pos = Vector2(size) / 2;
+	mouse_pos = Point2i(cursor_pos);
+	ProjectSettings::get_singleton()->set_setting("nx/cursor_visible", true);
+	Input::get_singleton()->set_event_dispatch_function(_dispatch_input_event);
+}
+
+DisplayServerSwitch::~DisplayServerSwitch() {
+	appletUnhook(&applet_cookie);
+#ifdef VULKAN_ENABLED
+	if (rendering_device_vulkan) {
+		rendering_device_vulkan->finalize();
+		memdelete(rendering_device_vulkan);
+	}
+	if (context_vulkan) {
+		memdelete(context_vulkan);
+	}
+#endif
+#ifdef GLES3_ENABLED
+	if (egl_display != EGL_NO_DISPLAY) {
+		eglMakeCurrent(egl_display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+		if (egl_context != EGL_NO_CONTEXT) {
+			eglDestroyContext(egl_display, egl_context);
+		}
+		if (egl_surface != EGL_NO_SURFACE) {
+			eglDestroySurface(egl_display, egl_surface);
+		}
+		eglTerminate(egl_display);
+	}
+#endif
+	ds_singleton = nullptr;
+}
+
+DisplayServer *DisplayServerSwitch::create_func(const String &p_rendering_driver, WindowMode p_window_mode, VSyncMode p_vsync_mode, uint32_t p_flags, const Point2i *p_position, const Size2i &p_resolution, int p_screen, Error &r_error) {
+	return memnew(DisplayServerSwitch(p_rendering_driver, p_window_mode, p_vsync_mode, p_flags, p_position, p_resolution, p_screen, r_error));
+}
