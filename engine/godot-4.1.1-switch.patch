new file mode 100644
index 0000000..c3ddefb
--- /dev/null
+++ b/platform/switch/SCsub
@@ -0,0 +1,37 @@
+#!/usr/bin/env python
+
+Import("env")
+
+files = [
+    "godot_switch.cpp",
+    "os_switch.cpp",
+    "display_server_switch.cpp",
+    "audio_driver_switch.cpp",
+    "posix_stubs.c",
+]
+if env["vulkan"]:
+    files += ["vulkan_context_switch.cpp", "nvk_compat.c"]
+if env["zink"]:
+    files += ["nvk_compat.c"]
+    if not env["lsfg"]:
+        env_hook = env.Clone()
+        env_hook.Prepend(CPPPATH=["#thirdparty/vulkan/include"])
+        files += [env_hook.Object("nx_zink_hook.cpp")]
+if env["lsfg"]:
+    # Zink + lsfg-vk (GPL-3.0-or-later, third_party/lsfg-vk, from the P.T. port; needs C++20 and exceptions).
+    import glob, os
+
+    lsfg = os.path.abspath(Dir("#").abspath + "/../third_party/lsfg-vk").replace("\\", "/")
+    env_lsfg = env.Clone()
+    env_lsfg["CXXFLAGS"] = [f for f in env_lsfg["CXXFLAGS"] if not str(f).startswith("-std=")] + ["-std=gnu++20", "-fexceptions", "-w"]
+    env_lsfg.Prepend(CPPPATH=["#thirdparty/vulkan/include", "#thirdparty/vulkan/include/vulkan",
+                              lsfg + "/lsfg-vk-backend/include", lsfg + "/lsfg-vk-common/include",
+                              lsfg + "/lsfg-vk-backend/src", lsfg + "/lsfg-vk-common/src", "#platform/switch/compat"])
+    srcs = glob.glob(lsfg + "/lsfg-vk-backend/src/**/*.cpp", recursive=True) + glob.glob(lsfg + "/lsfg-vk-common/src/**/*.cpp", recursive=True)
+    objdir = Dir("#bin/obj_lsfg").abspath
+    for src in srcs:
+        rel = os.path.relpath(src, lsfg).replace("\\", "/").replace("/", "_")[:-4]
+        files += [env_lsfg.Object(objdir + "/" + rel + env["OBJSUFFIX"], src)]
+    files += [env_lsfg.Object("nx_zink_hook.cpp")]
+
+prog = env.add_program("#bin/godot", files)
diff --git a/platform/switch/audio_driver_switch.cpp b/platform/switch/audio_driver_switch.cpp
new file mode 100644
index 0000000..2e9c375
--- /dev/null
+++ b/platform/switch/audio_driver_switch.cpp
@@ -0,0 +1,87 @@
+#include "audio_driver_switch.h"
+
+#include <malloc.h>
+#include <string.h>
+#include "nx.h"
+
+static constexpr size_t align_up(size_t v, size_t a) { return (v + a - 1) & ~(a - 1); }
+
+Error AudioDriverSwitch::init() {
+	if (R_FAILED(audoutInitialize())) {
+		return FAILED;
+	}
+	if (R_FAILED(audoutStartAudioOut())) {
+		audoutExit();
+		return FAILED;
+	}
+	mix_rate = audoutGetSampleRate();
+	if (mix_rate <= 0) {
+		mix_rate = 48000;
+	}
+	mix_buf = (int32_t *)memalloc(sizeof(int32_t) * BUFFER_FRAMES * CHANNELS);
+	size_t data_size = BUFFER_FRAMES * CHANNELS * sizeof(int16_t);
+	size_t buf_size = align_up(data_size, 0x1000);
+	AudioOutBuffer *bufs = (AudioOutBuffer *)memalloc(sizeof(AudioOutBuffer) * BUFFER_COUNT);
+	for (int i = 0; i < BUFFER_COUNT; i++) {
+		out_data[i] = (int16_t *)memalign(0x1000, buf_size);
+		memset(out_data[i], 0, buf_size);
+		bufs[i].next = nullptr;
+		bufs[i].buffer = out_data[i];
+		bufs[i].buffer_size = buf_size;
+		bufs[i].data_size = data_size;
+		bufs[i].data_offset = 0;
+	}
+	out_bufs = bufs;
+	active = true;
+	return OK;
+}
+
+void AudioDriverSwitch::thread_func(void *p_udata) {
+	AudioDriverSwitch *ad = (AudioDriverSwitch *)p_udata;
+	AudioOutBuffer *bufs = (AudioOutBuffer *)ad->out_bufs;
+
+	for (int i = 0; i < BUFFER_COUNT; i++) {
+		audoutAppendAudioOutBuffer(&bufs[i]);
+	}
+
+	while (!ad->exit_thread.is_set()) {
+		AudioOutBuffer *released = nullptr;
+		u32 count = 0;
+		if (R_FAILED(audoutWaitPlayFinish(&released, &count, 100000000ULL)) || !released) {
+			continue;
+		}
+		ad->lock();
+		ad->audio_server_process(BUFFER_FRAMES, ad->mix_buf);
+		ad->unlock();
+		int16_t *dst = (int16_t *)released->buffer;
+		for (int i = 0; i < BUFFER_FRAMES * CHANNELS; i++) {
+			dst[i] = int16_t(ad->mix_buf[i] >> 16);
+		}
+		armDCacheFlush(dst, released->data_size);
+		audoutAppendAudioOutBuffer(released);
+	}
+}
+
+void AudioDriverSwitch::start() {
+	if (active) {
+		thread.start(AudioDriverSwitch::thread_func, this);
+	}
+}
+
+void AudioDriverSwitch::finish() {
+	if (!active) {
+		return;
+	}
+	exit_thread.set();
+	if (thread.is_started()) {
+		thread.wait_to_finish();
+	}
+	audoutStopAudioOut();
+	audoutExit();
+	for (int i = 0; i < BUFFER_COUNT; i++) {
+		free(out_data[i]);
+	}
+	memfree(out_bufs);
+	memfree(mix_buf);
+	active = false;
+}
diff --git a/platform/switch/audio_driver_switch.h b/platform/switch/audio_driver_switch.h
new file mode 100644
