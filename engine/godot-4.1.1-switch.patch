+void DisplayServerSwitch::cursor_set_custom_image(const Ref<Resource> &p_cursor, CursorShape p_shape, const Vector2 &p_hotspot) {
+	// Drawn by res://nx/NxCursor.gd (an overlay autoload): hand it the game's cursor image.
+	if (p_shape != CURSOR_ARROW) {
+		return;
+	}
+	ProjectSettings::get_singleton()->set_setting("nx/cursor", p_cursor);
+	ProjectSettings::get_singleton()->set_setting("nx/cursor_hotspot", p_hotspot);
