+
+const char *VulkanContextSwitch::_get_platform_surface_extension() const {
+	return VK_NN_VI_SURFACE_EXTENSION_NAME;
+}
+
+Error VulkanContextSwitch::window_create(void *p_nwindow, DisplayServer::VSyncMode p_vsync_mode, int p_width, int p_height) {
+	VkViSurfaceCreateInfoNN info = {};
+	info.sType = VK_STRUCTURE_TYPE_VI_SURFACE_CREATE_INFO_NN;
+	info.window = p_nwindow;
+	VkSurfaceKHR surface;
+	VkResult err = vkCreateViSurfaceNN(get_instance(), &info, nullptr, &surface);
+	ERR_FAIL_COND_V_MSG(err != VK_SUCCESS, ERR_CANT_CREATE, "vkCreateViSurfaceNN failed with error " + itos(err));
+	return _window_create(DisplayServer::MAIN_WINDOW_ID, p_vsync_mode, surface, p_width, p_height);
+}
