@@ -0,0 +1,28 @@
+// POSIX calls that newlib/libnx do not provide. Godot only uses them for process control
+// and debugging hooks, which do not exist on Horizon.
+#include <errno.h>
+#include <signal.h>
+#include <stdio.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+
+mode_t umask(mode_t mask) { (void)mask; return 022; }
+pid_t waitpid(pid_t pid, int *status, int options) { (void)pid; (void)status; (void)options; errno = ECHILD; return -1; }
+int sigaction(int sig, const struct sigaction *act, struct sigaction *old) { (void)sig; (void)act; (void)old; return 0; }
+int execvp(const char *file, char *const argv[]) { (void)file; (void)argv; errno = ENOSYS; return -1; }
+FILE *popen(const char *cmd, const char *mode) { (void)cmd; (void)mode; errno = ENOSYS; return NULL; }
+int pclose(FILE *f) { (void)f; return -1; }
+pid_t setsid(void) { errno = ENOSYS; return -1; }
+
+// newlib's getentropy (arc4random_buf in libexpat, used by nxvk) needs this hook; libnx does not supply it.
+#include <switch/kernel/random.h>
+struct _reent;
+int _getentropy_r(struct _reent *r, void *buf, size_t len) {
+	(void)r;
+	if (len > 256) {
+		errno = EIO;
+		return -1;
+	}
+	randomGet(buf, len);
+	return 0;
+}
