+#ifdef NX_ZINK
+// Switch (Zink on NVK): the viewport is stretched to the screen with one fullscreen triangle (nearest sampling, like the
+// blit it replaces) rather than through NVK's scaled image blit, which draws two triangles.
+static GLuint nx_stretch_program = 0, nx_stretch_vao = 0;
+static GLint nx_stretch_flip = -1;
+static bool nx_stretch_init() {
+	if (nx_stretch_program) {
+		return true;
+	}
+	static const char *vs =
+			"#version 300 es\n"
+			"uniform float flip;\n"
+			"out vec2 uv;\n"
+			"void main() {\n"
+			"  vec2 p = vec2(float((gl_VertexID << 1) & 2), float(gl_VertexID & 2)) * 2.0 - 1.0;\n"
+			"  uv = p * 0.5 + 0.5;\n"
+			"  if (flip > 0.5) uv.y = 1.0 - uv.y;\n"
+			"  gl_Position = vec4(p, 0.0, 1.0);\n"
+			"}\n";
+	static const char *fs =
+			"#version 300 es\n"
+			"precision mediump float;\n"
+			"uniform sampler2D src;\n"
+			"in vec2 uv;\n"
+			"out vec4 frag;\n"
+			"void main() { frag = texture(src, uv); }\n";
+	GLuint v = glCreateShader(GL_VERTEX_SHADER);
+	glShaderSource(v, 1, &vs, nullptr);
+	glCompileShader(v);
+	GLuint f = glCreateShader(GL_FRAGMENT_SHADER);
+	glShaderSource(f, 1, &fs, nullptr);
+	glCompileShader(f);
+	GLuint p = glCreateProgram();
+	glAttachShader(p, v);
+	glAttachShader(p, f);
+	glLinkProgram(p);
+	glDeleteShader(v);
+	glDeleteShader(f);
+	GLint ok = 0;
+	glGetProgramiv(p, GL_LINK_STATUS, &ok);
+	if (!ok) {
+		glDeleteProgram(p);
+		return false;
+	}
+	nx_stretch_program = p;
+	nx_stretch_flip = glGetUniformLocation(p, "flip");
+	glUseProgram(p);
+	glUniform1i(glGetUniformLocation(p, "src"), 0);
+	glUseProgram(0);
+	glGenVertexArrays(1, &nx_stretch_vao);
+	return true;
+}
+#endif
